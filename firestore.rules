rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ==================================================================
       공통 헬퍼
       ================================================================== */
    function authed() {
      return request.auth != null;
    }
    // 문자열 필드가 "있다면" 문자열이고 길이 상한 안인지 확인한다(없으면 통과).
    // Firestore 문서 하나는 1MB까지 들어가므로, 상한이 없으면 로그인한 사람 누구나
    // API를 직접 호출해 거대한 문서를 계속 만들어 읽기/저장 비용을 부풀릴 수 있다.
    // null도 통과시킨다 — 클라이언트는 "값이 없음"을 null로 저장하는 자리가 여럿 있다
    // (최상위 댓글의 parentCommentId, 게시글 신고의 postId, 표시 이름이 없는 구글 계정의 name).
    // 이걸 빠뜨렸더니 최상위 댓글 작성이 통째로 거부됐다 — 길이 제한의 목적은 "거대한 문자열"을
    // 막는 것이지 빈 값을 막는 게 아니다.
    function strOk(data, field, maxLen) {
      return !(field in data)
        || data[field] == null
        || (data[field] is string && data[field].size() <= maxLen);
    }
    // 두 uid로 만들어지는 1:1 대화방 문서 id (클라이언트의 chatIdFor: 정렬 후 "_"로 연결).
    // Firebase uid는 영숫자라 JS의 sort()와 규칙의 문자열 비교 결과가 항상 같다.
    function chatIdBetween(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // posts.likes/views/commentCount는 로그인만 하면 누구나 고칠 수 있는 카운터라(좋아요는
    // 작성자가 아닌 다른 사람이 눌러야 하니 그 자체는 맞는 설계), 값 검증이 없으면 인증된
    // 사용자가 API를 직접 호출해 값을 임의로 부풀리거나 깎을 수 있었다. 한 번의 update 호출이
    // 바꿀 수 있는 변화폭을 실제 클라이언트 동작(좋아요 토글 ±1, 조회수 +1)만큼으로 제한한다.
    // commentCount는 답글이 달린 댓글을 지울 때 한 번에 여러 개가 줄어들 수 있어(cascading
    // delete) 감소 쪽만 폭을 열어둔다 — 어차피 감소는 표시 숫자만 줄이는 낮은 위험이고, 실제
    // 댓글 생성/삭제 권한은 comments 서브컬렉션 규칙이 별도로 지킨다.
    function isValidPostCounterUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['likes', 'views', 'commentCount'])
        && (!changed.hasAny(['likes']) ||
            request.resource.data.likes == resource.data.likes + 1 ||
            request.resource.data.likes == resource.data.likes - 1)
        && (!changed.hasAny(['views']) ||
            request.resource.data.views == resource.data.views + 1)
        && (!changed.hasAny(['commentCount']) ||
            request.resource.data.commentCount == resource.data.commentCount + 1 ||
            request.resource.data.commentCount < resource.data.commentCount);
    }

    // studentEmail은 클라이언트(온보딩 위저드, isUniversityEmail())가 이미 .edu/.ac.kr류 학교
    // 도메인 패턴인지 검사하지만, 그건 UI 단의 편의 검증일 뿐이라 devtools로 Firestore를 직접
    // 호출하면 그냥 우회된다. 실제 소유권 확인(메일 발송)까지는 아니어도, 최소한 "학교스러운
    // 도메인 패턴"이라는 조건은 서버(규칙)에서도 강제해서 클라이언트 검증이 장식이 되지 않게 한다.
    function isAcademicEmail(email) {
      let e = email.lower();
      return e.matches('^[^@\\s]+@[^@\\s]+[.](edu|edu[.][a-z]{2}|ac[.][a-z]{2})$')
        || e.matches('^[^@\\s]+@(utoronto[.]ca|ubc[.]ca|mcgill[.]ca|sciencespo[.]fr|sorbonne-universite[.]fr|tum[.]de|usp[.]br)$');
    }

    // 프로필 자유 텍스트 상한. 온보딩 위저드가 실제로 받는 길이(이름/학교/전공 한 줄, 자기소개
    // 300자)보다 넉넉하게 잡되, 문서 하나가 수백 KB로 부풀지는 못하게 한다.
    function isValidUserProfile(data) {
      return strOk(data, 'name', 100)
        && strOk(data, 'university', 200)
        && strOk(data, 'major', 100)
        && strOk(data, 'bio', 2000)
        && strOk(data, 'country', 100)
        && strOk(data, 'studentEmail', 254)
        && (!('interests' in data) || (data.interests is list && data.interests.size() <= 30))
        && (!('dreamExchangeCountries' in data) || (data.dreamExchangeCountries is list && data.dreamExchangeCountries.size() <= 30))
        && (!('blockedUids' in data) || (data.blockedUids is list && data.blockedUids.size() <= 2000))
        && (!('savedStudents' in data) || (data.savedStudents is list && data.savedStudents.size() <= 2000))
        // "찾고 있는 것" — 정해진 선택지 몇 개뿐이라 10개면 충분하다.
        && (!('lookingFor' in data) || (data.lookingFor is list && data.lookingFor.size() <= 10))
        // 프로젝트(제목·설명·역할 등)는 map 하나다. 필드 수와 자유 텍스트 길이에 상한을 둔다.
        && (!('project' in data) || data.project == null
            || (data.project is map && data.project.size() <= 12
                && strOk(data.project, 'title', 200)
                && strOk(data.project, 'description', 2000)
                && strOk(data.project, 'category', 60)
                && (!('roles' in data.project) || (data.project.roles is list && data.project.roles.size() <= 10))));
    }

    match /users/{userId} {
      allow read: if authed();
      allow create, update: if authed() && request.auth.uid == userId
        && isValidUserProfile(request.resource.data)
        && ( !('studentEmail' in request.resource.data)
             || request.resource.data.studentEmail == ''
             || isAcademicEmail(request.resource.data.studentEmail) );
      // 회원 탈퇴: 본인 문서만 삭제 가능.
      allow delete: if authed() && request.auth.uid == userId;

      // users/{uid} 문서는 "로그인한 사람 누구나" 읽을 수 있어야 한다(탐색 탭의 학생 카드가
      // 그 문서를 그대로 읽어 그린다). Firestore에는 필드 단위 읽기 규칙이 없으므로, 남에게
      // 보일 필요가 전혀 없는 값(학교 이메일 등 연락처)은 아예 이 하위 컬렉션에 따로 담아
      // 본인만 읽을 수 있게 한다 — 그렇지 않으면 계정 하나만 만들면 전체 회원의 학교 이메일을
      // 그대로 긁어갈 수 있다.
      match /private/{docId} {
        allow read, write: if authed() && request.auth.uid == userId;
      }
    }

    match /posts/{postId} {
      allow read: if authed();

      // 새 글: 반드시 본인 uid로, 좋아요/조회수/댓글수가 0인 상태로만 생성 가능.
      // (댓글 자체는 이제 이 문서 안이 아니라 아래 comments 서브컬렉션에 별도로 생성된다.)
      // 필드 목록·길이도 함께 고정한다 — 규칙이 본문 길이를 안 보면 API를 직접 호출해
      // 1MB짜리 글을 얼마든지 만들어 넣을 수 있고, 그 글은 커뮤니티를 여는 모든 사용자에게
      // 매번 다운로드된다(읽기 비용 폭탄 + 화면 마비).
      allow create: if authed()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.likes == 0
        && request.resource.data.views == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.keys().hasOnly(
             ['authorUid', 'authorName', 'authorInitial', 'lang', 'categoryKey',
              'title', 'body', 'tags', 'likes', 'views', 'commentCount', 'createdAt'])
        && strOk(request.resource.data, 'title', 300)
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 10000
        && strOk(request.resource.data, 'authorName', 100)
        && strOk(request.resource.data, 'authorInitial', 8)
        && strOk(request.resource.data, 'lang', 16)
        && strOk(request.resource.data, 'categoryKey', 64)
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 10;

      // 수정 1) 좋아요/조회수/댓글수 갱신: 로그인만 하면 누구나
      //         (commentCount는 댓글 서브컬렉션에 실제로 글을 쓸 수 있는 사람만 늘릴 수 있으므로,
      //          여기서 로그인 여부만 확인해도 안전하다 - 아래 comments 서브컬렉션 규칙이 진짜 관문).
      // 수정 2) 본문 수정(title/body/tags/categoryKey): 반드시 작성자 본인(authorUid 일치)만.
      allow update: if authed() && (
        isValidPostCounterUpdate()
        ||
        // 길이 검사는 "값이 있으면" 확인한다 — 태그나 본문이 없는 옛 게시글을 수정할 때
        // 그 자체가 거부되지 않도록(댓글 parentCommentId에서 겪은 것과 같은 함정).
        (request.auth.uid == resource.data.authorUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'tags', 'categoryKey'])
          && strOk(request.resource.data, 'title', 300)
          && strOk(request.resource.data, 'body', 10000)
          && (!('tags' in request.resource.data)
              || (request.resource.data.tags is list && request.resource.data.tags.size() <= 10)))
      );

      // 삭제: 작성자 본인만 가능.
      allow delete: if authed() && request.auth.uid == resource.data.authorUid;

      match /comments/{commentId} {
        // 댓글은 게시글 참여자 누구나 읽을 수 있다 (게시글 자체를 읽을 수 있으면 댓글도 볼 수 있어야 하므로).
        allow read: if authed();

        // 새 댓글/답글: 반드시 본인 uid로만, 좋아요 0에서, 정해진 필드/길이로만 작성 가능.
        allow create: if authed()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.likes == 0
          && request.resource.data.keys().hasOnly(
               ['authorUid', 'authorName', 'authorInitial', 'lang', 'text', 'likes', 'createdAt', 'parentCommentId'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000
          && strOk(request.resource.data, 'authorName', 100)
          && strOk(request.resource.data, 'authorInitial', 8)
          && strOk(request.resource.data, 'lang', 16)
          && strOk(request.resource.data, 'parentCommentId', 200);

        // 수정: ① 댓글 작성자 본인이 text만 고치는 경우, ② 로그인한 사람 누구나 likes를 ±1만
        //      바꾸는 경우(좋아요는 작성자가 아니어도 가능해야 해서 별도로 허용 — posts.likes와
        //      동일한 이유로 변화폭을 클라이언트의 실제 토글 동작만큼으로 제한).
        allow update: if authed() && (
          (request.auth.uid == resource.data.authorUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 5000)
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
            && (request.resource.data.likes == resource.data.likes + 1
                || request.resource.data.likes == resource.data.likes - 1))
        );

        // 삭제: 댓글 작성자 본인만.
        allow delete: if authed() && request.auth.uid == resource.data.authorUid;
      }
    }

    match /chats/{chatId} {
      // 대화 참여자 본인만 읽을 수 있음.
      // resource == null 허용: __startOrGetChat이 새 대화를 만들기 전에 getDoc()으로 존재 여부부터
      // 확인하는데, 문서가 아직 없으면 resource가 null이라 resource.data 접근 자체가 거부돼서
      // "메시지를 시작할 수 없습니다" 에러로 이어지던 버그(mockChats에서 이미 겪었던 것과 동일한 패턴).
      allow read: if authed()
        && (resource == null || request.auth.uid in resource.data.participants);

      // 새 대화방: 참여자는 정확히 2명(서로 다른 사람), 본인이 그중 한 명이어야 하고,
      // 서로 차단한 사이가 아니어야 함.
      // status는 없거나(레거시 대화방 — 항상 "수락됨"으로 취급) 'pending'/'accepted' 중 하나만 허용하고,
      // 'pending'으로 만드는 건 반드시 본인이 requestedBy로 요청을 보낼 때만 가능하다(남을 대신해서
      // 대기 요청을 만들 수 없도록).
      // 문서 id도 실제 참여자 두 명으로 만들어진 id(chatIdFor)와 일치해야 한다 — 그렇지 않으면
      // 같은 상대와의 대화방을 임의의 id로 무한정 만들어 상대 메시지함을 도배할 수 있다.
      allow create: if authed()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && chatId == chatIdBetween(request.resource.data.participants[0], request.resource.data.participants[1])
        && !(request.resource.data.participants[0] in
              get(/databases/$(database)/documents/users/$(request.resource.data.participants[1])).data.get('blockedUids', []))
        && !(request.resource.data.participants[1] in
              get(/databases/$(database)/documents/users/$(request.resource.data.participants[0])).data.get('blockedUids', []))
        && request.resource.data.get('status', 'accepted') in ['pending', 'accepted']
        && (request.resource.data.get('status', 'accepted') != 'pending'
            || request.resource.data.requestedBy == request.auth.uid)
        && strOk(request.resource.data, 'lastMessage', 5000)
        && strOk(request.resource.data, 'projectTitle', 300);

      // 수정: 참여자 본인만, participants 배열 자체는 바꿀 수 없음(대화 상대를 바꿔치기 못하도록).
      // status 필드가 바뀌는 경우엔 다음 두 가지 전환만 허용한다:
      //   1) pending -> accepted/declined: 요청을 "받은" 쪽(requestedBy가 아닌 참여자)만 가능,
      //      requestedBy/requestType은 그대로 유지되어야 함(위조 방지).
      //   2) (status가 아예 없거나 declined인) 대화에서 참여자 본인이 새로 pending 요청을 보냄 —
      //      "정식으로 수락된 적 없는" 대화라면(레거시 대화 포함) Connect/프로젝트 참여 버튼을
      //      다시 눌러 새 요청 카드를 보낼 수 있게 한다. 이미 accepted이거나 이미 pending인
      //      대화는 이 경로로 건드릴 수 없다(진행 중인 관계를 임의로 되돌리지 못하도록).
      // 보안 감사로 발견된 우회 경로 수정: status를 안 건드리면 requestedBy/requestType까지
      // 자유롭게 바꿀 수 있었다 — 예를 들어 요청을 "받은" 쪽이 status는 그대로 둔 채
      // requestedBy를 자기 자신으로 슬쩍 바꿔치기하면, 대기(pending) 상태에서 먼저 메시지를
      // 보낼 수 있는 권한(messages create 규칙이 requestedBy로 판단)을 부정하게 얻을 수 있었다.
      // status와 마찬가지로 requestedBy/requestType도 아래 두 전이(전환) 분기를 통해서만
      // 바뀔 수 있도록 묶는다.
      // projectOwnerUid도 같이 잠근다: 이 값은 "프로젝트 채널에 상대를 넣을 수 있는 사람"을
      // 정하는 근거(projectChannels 규칙이 이 필드를 본다)라서, 아무 때나 자기 자신으로
      // 바꿔치기할 수 있으면 채널 강제 초대의 우회로가 된다.
      allow update: if authed()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && strOk(request.resource.data, 'lastMessage', 5000)
        && strOk(request.resource.data, 'projectTitle', 300)
        && ( !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'requestedBy', 'requestType', 'projectOwnerUid', 'projectRequestedBy'])
             || ( resource.data.status == 'pending'
                  && request.auth.uid != resource.data.requestedBy
                  && request.resource.data.status in ['accepted', 'declined']
                  && request.resource.data.requestedBy == resource.data.requestedBy
                  && request.resource.data.requestType == resource.data.requestType
                  && request.resource.data.get('projectOwnerUid', '') == resource.data.get('projectOwnerUid', '') )
             || ( (resource.data.get('status', null) == null || resource.data.status == 'declined')
                  && request.resource.data.status == 'pending'
                  && request.resource.data.requestedBy == request.auth.uid
                  && request.resource.data.requestType in ['connect', 'project']
                  && ( request.resource.data.get('projectOwnerUid', '') == ''
                       || request.resource.data.projectOwnerUid != request.auth.uid ) )
             || ( resource.data.get('status', '') == 'accepted'
                  && request.resource.data.status == 'accepted'
                  && request.resource.data.get('projectRequestedBy', '') == request.auth.uid
                  && request.resource.data.projectOwnerUid != request.auth.uid
                  && request.resource.data.get('requestedBy', '') == resource.data.get('requestedBy', '')
                  && request.resource.data.get('requestType', '') == resource.data.get('requestType', '') ) );

      allow delete: if false;

      match /messages/{messageId} {
        // 메시지는 그 대화방 참여자만 읽고 쓸 수 있고, 보낸 사람은 반드시 본인이어야 함.
        allow read: if authed()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        // 대화방이 대기(pending) 상태인 동안엔 요청을 "보낸" 사람만 메시지를 쓸 수 있다(첫인사 등).
        // 상대는 수락하기 전까진 답장을 보낼 수 없음 — 클라이언트에서 입력창을 숨기는 것과 별개로
        // 서버에서도 실제로 막는다. status가 없는(레거시) 대화방은 항상 열려있는 것과 동일하게 취급.
        allow create: if authed()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000
          && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt', 'reactions', 'replyTo', 'lang'])
          && (!('reactions' in request.resource.data) || request.resource.data.reactions.keys().size() == 0)
          && ( get(/databases/$(database)/documents/chats/$(chatId)).data.get('status', 'accepted') == 'accepted'
               || ( get(/databases/$(database)/documents/chats/$(chatId)).data.status == 'pending'
                    && request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.requestedBy ) );

        // 메시지 본문은 불변. 리액션(reactions) 필드만 대화 참여자 누구나 바꿀 수 있다(이모지 토글).
        // 이모지 종류 수에 상한을 둔다 — reactions는 클라이언트가 보내는 값을 그대로 저장하는
        // 유일한 "키가 자유로운" 필드라, 상한이 없으면 상대 대화창에 임의의 키를 수천 개 밀어넣을 수 있다.
        allow update: if authed()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions.keys().size() <= 12;

        allow delete: if false;
      }
    }

    match /projectChannels/{channelId} {
      // 프로젝트 참여 요청이 수락됐을 때만 생기는 다인 그룹 채널. channelId는 프로젝트 소유자의
      // uid를 그대로 쓴다(지금 데이터 모델상 한 유저가 동시에 하나의 모집 프로젝트만 가지므로).
      // resource == null 허용: __fbRespondToProjectRequest가 채널을 새로 만들기 전에 트랜잭션
      // 안에서 getDoc()으로 존재 여부부터 확인하는데, 문서가 아직 없으면 resource가 null이라
      // resource.data 접근 자체가 거부돼서 첫 수락(=채널이 처음 생기는 순간)마다 "처리에
      // 실패했어요" 에러로 이어지던 버그(chats 컬렉션에서 이미 겪었던 것과 동일한 패턴).
      allow read: if authed()
        && (resource == null || request.auth.uid in resource.data.memberUids);

      // 보안 감사로 발견된 "강제 초대" 취약점 수정:
      // 예전 규칙은 "내가 ownerUid이고 멤버가 2명"이기만 하면 됐다 — 즉 로그인한 사람 누구나
      // 임의의 channelId로 채널을 만들면서 아무 유저나 memberUids에 넣을 수 있었고, 그 순간
      // 상대(차단한 상대여도!)의 메시지함 "프로젝트 채널" 탭에 채널이 생기고 거기로 메시지를
      // 보낼 수 있었다(참여 수락/차단을 통째로 우회하는 스팸·괴롭힘 경로).
      // 이제는 ① 문서 id가 반드시 소유자 uid와 같아야 하고(1인 1채널),
      //        ② 같이 들어가는 상대는 실제로 "나에게 프로젝트 참여를 요청한 사람"이어야 한다
      //           (두 사람 사이의 chats 문서를 규칙에서 직접 확인).
      function isProjectRequester(memberUid) {
        let requestChatId = chatIdBetween(request.auth.uid, memberUid);
        let chat = get(/databases/$(database)/documents/chats/$(requestChatId));
        return chat != null
          && chat.data.get('projectOwnerUid', '') == request.auth.uid
          && ( chat.data.get('requestedBy', '') == memberUid
               || chat.data.get('projectRequestedBy', '') == memberUid );
      }
      function addedMember() {
        return request.resource.data.memberUids.removeAll(resource.data.memberUids)[0];
      }

      allow create: if authed()
        && channelId == request.auth.uid
        && request.auth.uid == request.resource.data.ownerUid
        && request.resource.data.memberUids.size() == 2
        && request.auth.uid in request.resource.data.memberUids
        && strOk(request.resource.data, 'title', 300)
        && isProjectRequester(request.resource.data.memberUids[0] == request.auth.uid
             ? request.resource.data.memberUids[1] : request.resource.data.memberUids[0]);

      // memberUids 변경은 오직 소유자만, 정확히 1명씩만 추가 가능(기존 멤버는 그대로 유지 — 아무도 빠지지 않음),
      // 그리고 새로 들어오는 사람은 실제로 참여를 요청한 사람이어야 한다.
      // 그 외에 멤버 누구나 할 수 있는 갱신은 마지막 메시지 미리보기뿐이다 — 예전에는 이 분기가
      // 없어서, 소유자가 아닌 멤버가 메시지를 보내면 채널 목록의 미리보기 갱신이 조용히 실패했다.
      allow update: if authed() && (
        ( request.auth.uid == resource.data.ownerUid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && resource.data.memberUids.removeAll(request.resource.data.memberUids).size() == 0
          && isProjectRequester(addedMember()) )
        ||
        ( request.auth.uid in resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt'])
          && strOk(request.resource.data, 'lastMessage', 5000) )
      );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if authed()
          && request.auth.uid in get(/databases/$(database)/documents/projectChannels/$(channelId)).data.memberUids;

        allow create: if authed()
          && request.auth.uid in get(/databases/$(database)/documents/projectChannels/$(channelId)).data.memberUids
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000
          && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt', 'reactions', 'replyTo', 'lang'])
          && (!('reactions' in request.resource.data) || request.resource.data.reactions.keys().size() == 0);

        allow update: if authed()
          && request.auth.uid in get(/databases/$(database)/documents/projectChannels/$(channelId)).data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions.keys().size() <= 12;

        allow delete: if false;
      }
    }

    match /mockChats/{mockChatId} {
      // AI로 생성된 학생 카드와의 시뮬레이션 대화. 실제 유저가 아니라 상대편이 없으므로,
      // 대화의 소유자(ownerUid) 본인만 읽고 쓸 수 있으면 충분하다 — 다른 유저는 절대 접근 불가.
      // resource == null 허용: __fbStartMockChat이 새 대화를 만들기 전에 getDoc()으로 존재 여부부터
      // 확인하는데, 문서가 아직 없으면 resource가 null이라 resource.data 접근 자체가 거부돼 버려서
      // "지금은 연결할 수 없어요" 에러로 이어지던 버그. 없는 문서를 읽는 건 어차피 아무 정보도
      // 안 새서(그냥 "없음"으로만 응답) 허용해도 안전하다.
      allow read: if authed()
        && (resource == null || resource.data.ownerUid == request.auth.uid);
      allow create: if authed() && request.resource.data.ownerUid == request.auth.uid
        && strOk(request.resource.data, 'lastMessage', 5000);
      allow update: if authed() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && strOk(request.resource.data, 'lastMessage', 5000);
      allow delete: if authed() && resource.data.ownerUid == request.auth.uid;

      match /messages/{messageId} {
        // 메시지 자체엔 ownerUid가 없으니, 부모 mockChats 문서의 ownerUid로 소유권을 확인한다.
        allow read: if authed()
          && get(/databases/$(database)/documents/mockChats/$(mockChatId)).data.ownerUid == request.auth.uid;
        // 삭제는 request.resource가 null이라 길이 검사를 건너뛴다.
        allow write: if authed()
          && get(/databases/$(database)/documents/mockChats/$(mockChatId)).data.ownerUid == request.auth.uid
          && (request.resource == null || strOk(request.resource.data, 'text', 5000));
      }
    }

    match /notifications/{notifId} {
      // 다른 실제 유저가 나에게 Connect(대화 시작/프로젝트 참여 요청)를 보내면 만들어지는 알림.
      // 받는 사람(recipientUid) 본인만 읽고, 보낸 사람(actorUid)은 본인 명의로만 새로 만들 수 있다.
      allow read: if authed() && resource.data.recipientUid == request.auth.uid;

      // 보안 감사로 발견된 신원 사칭 문제 수정: actorName/actorUniversity/actorMajor를 예전엔
      // 클라이언트가 보내는 값 그대로 믿었다 — 로그인한 사람 누구나 임의의 이름·학교·전공을
      // 사칭해서 다른 유저에게 "OO님이 커넥트를 요청했어요" 알림을 보낼 수 있었다(실명 기반
      // 네트워킹 서비스라 피싱/사칭 벡터가 됨). 이제 실제 본인 users/{uid} 문서에 저장된
      // 값과 정확히 일치할 때만 생성을 허용한다.
      allow create: if authed()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.recipientUid != request.auth.uid
        // connect/project: 요청을 보낼 때, accepted/project_accepted: 요청을 받은 사람이 수락했을 때,
        // comment: 남의 글에 댓글을 달았을 때. 신원 필드는 아래에서 본인 프로필과 대조한다.
        && request.resource.data.type in ['connect', 'project', 'accepted', 'project_accepted', 'comment']
        && request.resource.data.read == false
        && strOk(request.resource.data, 'projectTitle', 300)
        && request.resource.data.actorName ==
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('name', '')
        && request.resource.data.actorUniversity ==
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('university', '')
        && request.resource.data.actorMajor ==
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('major', '')
        && request.resource.data.keys().hasOnly(
             ['recipientUid', 'type', 'actorUid', 'actorName', 'actorUniversity', 'actorMajor', 'chatId', 'read', 'createdAt', 'projectTitle', 'postId']
           );

      // 수정: 받는 사람 본인이 읽음 처리(read)만 할 수 있다.
      allow update: if authed() && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      // 삭제: 받는 사람 본인만.
      allow delete: if authed() && resource.data.recipientUid == request.auth.uid;
    }

    // 번역 결과 공유 캐시 — 같은 UI 문구를 여러 유저/세션이 반복해서 Gemini로 재번역하는 비용·지연을
    // 줄이려고, 한 번 번역된 (원문, 번역문) 쌍을 저장해두고 다음엔 재사용한다. 문서 ID는 원문을
    // FNV-1a로 해시한 값이라 그 자체로 민감하지 않다 — 누구나 읽을 수 있어도 된다(로그인 안 한
    // 방문자도 마케팅 홈페이지를 다른 언어로 봐야 하므로 읽기는 로그인을 요구하지 않는다).
    // 단, 읽기가 완전히 공개(목록 조회까지 가능)라는 건 "여기 들어간 문장은 전부 공개된다"는
    // 뜻이다 — 그래서 클라이언트는 화면에 박힌 UI 문구만 여기에 기여한다(개인 메시지/프로필
    // 자유 텍스트는 기기 안 localStorage 캐시에만 남는다. 20260801.html의 isShareableText 참고).
    // 쓰기는 로그인한 유저만, 그리고 "생성"만 허용해 한 번 캐시된 항목은 덮어써서 오염시킬 수
    // 없게 한다(같은 해시로 두 유저가 동시에 처음 번역해도 나중 쓰기는 그냥 실패 — 의도된 동작).
    // 꺾쇠(< >)가 들어간 값은 아예 거부한다: 이 캐시의 번역문은 화면 곳곳에서 innerHTML로
    // 들어가므로, 먼저 쓰는 사람이 태그를 심으면 그 문구를 보는 모든 유저 브라우저에서 실행되는
    // 저장형 XSS가 된다(클라이언트에서도 같은 값을 한 번 더 걸러낸다 — 이중 방어).
    match /translationCache/{lang}/strings/{hash} {
      allow read: if true;
      allow create: if authed()
        && request.resource.data.text is string && request.resource.data.text.size() < 2000
        && request.resource.data.translated is string && request.resource.data.translated.size() < 4000
        && !request.resource.data.text.matches('(?s).*[<>].*')
        && !request.resource.data.translated.matches('(?s).*[<>].*')
        && request.resource.data.keys().hasOnly(['text', 'translated', 'createdAt']);
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      // 신고: 로그인한 사람이 "본인이 신고자"로만 생성 가능.
      // 읽기는 신고한 본인 것만 — 마이페이지 → 활동 → "신고한 내역"이 이 규칙으로 조회한다
      // (where("reporterUid","==",내 uid) 쿼리만 통과한다). 남의 신고는 여전히 못 본다.
      // 운영자용 열람 화면은 아직 없어서 전체 조회는 Firebase Console에서 해야 하고,
      // 수정/삭제는 신고자 본인에게도 막아둔다 — 신고 기록은 남아 있어야 한다.
      allow read: if authed() && resource.data.reporterUid == request.auth.uid;
      allow create: if authed()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.type in ['post', 'comment']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500
        && request.resource.data.keys().hasOnly(
             ['reporterUid', 'reportedUid', 'type', 'targetId', 'postId', 'reason', 'status', 'createdAt'])
        && strOk(request.resource.data, 'targetId', 200)
        && strOk(request.resource.data, 'postId', 200)
        && request.resource.data.status == 'open';
      allow update, delete: if false;
    }

    // 아직 정의되지 않은 다른 모든 컬렉션은 기본적으로 차단.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
